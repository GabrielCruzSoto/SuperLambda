#!/bin/bash

# Colores para mensajes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Función para imprimir mensajes
print_message() {
    local type=$1
    local message=$2
    case $type in
        "error")
            echo -e "${RED}Error: ${message}${NC}"
            ;;
        "success")
            echo -e "${GREEN}Success: ${message}${NC}"
            ;;
        "info")
            echo -e "${YELLOW}Info: ${message}${NC}"
            ;;
    esac
}

# Función para validar que AWS CLI está instalado
check_aws_cli() {
    if ! command -v aws &> /dev/null; then
        print_message "error" "AWS CLI no está instalado. Por favor, instálalo primero."
        exit 1
    fi
}

# Función para crear un nuevo proyecto
create_project() {
    local project_name=$1
    local description=$2
    local template_repo="https://github.com/yourusername/SuperLambdaTemplete.git"

    # Validar que se proporcionaron los parámetros necesarios
    if [ -z "$project_name" ] || [ -z "$description" ]; then
        print_message "error" "Debe proporcionar nombre y descripción del proyecto"
        echo "Uso: $0 create-project <nombre_proyecto> \"<descripcion>\""
        exit 1
    fi

    # Clonar el template
    print_message "info" "Clonando template para el proyecto $project_name..."
    if git clone "$template_repo" "$project_name"; then
        # Actualizar el archivo de configuración
        config_file="$project_name/.config/info-lambda.json"
        if [ -f "$config_file" ]; then
            # Actualizar el archivo JSON usando jq
            if command -v jq &> /dev/null; then
                jq --arg name "$project_name" --arg desc "$description" \
                   '.function_name = $name | .description = $desc' "$config_file" > "$config_file.tmp" && \
                mv "$config_file.tmp" "$config_file"
                print_message "success" "Proyecto creado exitosamente en $(pwd)/$project_name"
            else
                print_message "error" "jq no está instalado. Por favor, instálalo para manipular archivos JSON."
                exit 1
            fi
        else
            print_message "error" "No se encontró el archivo de configuración"
            exit 1
        fi
    else
        print_message "error" "No se pudo clonar el template"
        exit 1
    fi
}

# Función para desplegar la lambda
deploy_lambda() {
    local project_dir=$1
    
    # Validar que el directorio existe
    if [ ! -d "$project_dir" ]; then
        print_message "error" "El directorio del proyecto no existe"
        exit 1
    }

    # Leer el archivo de configuración
    local config_file="$project_dir/.config/info-lambda.json"
    if [ ! -f "$config_file" ]; then
        print_message "error" "No se encontró el archivo de configuración"
        exit 1
    }

    # Leer valores del archivo de configuración
    local function_name=$(jq -r '.function_name' "$config_file")
    local description=$(jq -r '.description' "$config_file")
    local runtime=$(jq -r '.runtime' "$config_file")
    local handler=$(jq -r '.handler' "$config_file")
    local timeout=$(jq -r '.timeout' "$config_file")
    local memory_size=$(jq -r '.memory_size' "$config_file")
    local source_dir=$(jq -r '.source_dir' "$config_file")
    local build_dir=$(jq -r '.build_dir' "$config_file")
    local bucket_name_code=$(jq -r '.bucket_name_code' "$config_file")
    local bucket_name_key=$(jq -r '.bucket_name_key' "$config_file")
    local name_zip=$(jq -r '.name_zip // .function_name' "$config_file")

    # Crear directorio de build si no existe
    mkdir -p "$project_dir/$build_dir"

    # Comprimir el código
    cd "$project_dir/$source_dir" || exit 1
    zip -r "../$build_dir/$name_zip.zip" ./*

    # Verificar si la función lambda existe
    if aws lambda get-function --function-name "$function_name" 2>/dev/null; then
        # Actualizar función existente
        if [ -n "$bucket_name_code" ] && [ -n "$bucket_name_key" ]; then
            # Subir código a S3
            aws s3 cp "$project_dir/$build_dir/$name_zip.zip" "s3://$bucket_name_code/$bucket_name_key"
            aws lambda update-function-code \
                --function-name "$function_name" \
                --s3-bucket "$bucket_name_code" \
                --s3-key "$bucket_name_key"
        else
            # Actualizar directamente con el archivo zip
            aws lambda update-function-code \
                --function-name "$function_name" \
                --zip-file "fileb://$project_dir/$build_dir/$name_zip.zip"
        fi
    else
        # Crear nueva función
        if [ -n "$bucket_name_code" ] && [ -n "$bucket_name_key" ]; then
            # Subir código a S3
            aws s3 cp "$project_dir/$build_dir/$name_zip.zip" "s3://$bucket_name_code/$bucket_name_key"
            aws lambda create-function \
                --function-name "$function_name" \
                --runtime "$runtime" \
                --role "arn:aws:iam::ACCOUNT_ID:role/ROLE_NAME" \
                --handler "$handler" \
                --description "$description" \
                --timeout "$timeout" \
                --memory-size "$memory_size" \
                --code "S3Bucket=$bucket_name_code,S3Key=$bucket_name_key"
        else
            # Crear con archivo zip local
            aws lambda create-function \
                --function-name "$function_name" \
                --runtime "$runtime" \
                --role "arn:aws:iam::ACCOUNT_ID:role/ROLE_NAME" \
                --handler "$handler" \
                --description "$description" \
                --timeout "$timeout" \
                --memory-size "$memory_size" \
                --zip-file "fileb://$project_dir/$build_dir/$name_zip.zip"
        fi
    fi

    # Configurar variables de entorno si existen
    if jq -e '.environment.Variables' "$config_file" > /dev/null; then
        aws lambda update-function-configuration \
            --function-name "$function_name" \
            --environment "$(jq '.environment' "$config_file")"
    fi

    # Configurar capas si existen
    if jq -e '.layers' "$config_file" > /dev/null; then
        aws lambda update-function-configuration \
            --function-name "$function_name" \
            --layers "$(jq -r '.layers[].name' "$config_file")"
    fi

    print_message "success" "Lambda desplegada exitosamente"
}

# Menú principal
case "$1" in
    "create-project")
        create_project "$2" "$3"
        ;;
    "deploy")
        check_aws_cli
        deploy_lambda
        ;;
    *)
        echo "Uso:"
        echo "  $0 create-project <nombre_proyecto> \"<descripcion>\""
        echo "  $0 deploy
        exit 1
        ;;
esac